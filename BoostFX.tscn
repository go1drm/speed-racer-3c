[gd_scene load_steps=34 format=3 uid="uid://bfxboost01car"]

[ext_resource type="Script" path="res://BoostFX.gd" id="1_fx"]

; ============================================================
;  喷射粒子特效 (v2: 细长焰柱 + 星星散粒)
;  参考: 图中"核心亮条 + 外围紫蓝光柱 + 金色四角星散落"的风格
;  尺寸目标:
;    · 宽度 ≈ 排气管直径 (约 0.1~0.15m) → 粒子 scale 取 0.08~0.2
;    · 长度 ≈ 玉麒麟车身长度的一半 (≈ 2.5m) → lifetime × velocity ≈ 2.5
;  每个 BoostType 由 2 个节点组成: 主焰柱(xxxFX) + 星星散粒(xxxStar)
;  主焰柱: 细长半透明光条, blend_mode=ADD; 星星: 金色点状, 略大scale, 稀疏
; ============================================================

; ============================================================
;  小 / 双 / 氮气: 主焰柱粒子形状 (所有类型共用小圆球, 细而长由速度+lifetime控制)
; ============================================================
[sub_resource type="SphereMesh" id="MeshCore"]
radius = 0.04
height = 0.08
radial_segments = 8
rings = 4

; ============================================================
;  星星: 四角星 (用 QuadMesh + 星星纹理? 暂用小球做替代, scale 稍大)
;  TODO: 宝宝要真正的四角星可以换 QuadMesh + star.png 纹理
; ============================================================
[sub_resource type="SphereMesh" id="MeshStar"]
radius = 0.06
height = 0.12
radial_segments = 6
rings = 3

; ========== 小喷: 蓝色细焰柱 ==========
[sub_resource type="StandardMaterial3D" id="MatMini"]
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(0.5, 0.85, 1.0, 1)
emission_enabled = true
emission = Color(0.3, 0.7, 1.0, 1)
emission_energy_multiplier = 3.5
blend_mode = 1
cull_mode = 2

[sub_resource type="ParticleProcessMaterial" id="ProcMini"]
emission_shape = 1
emission_sphere_radius = 0.02
direction = Vector3(0, 0, 1)
spread = 3.0
initial_velocity_min = 5.0
initial_velocity_max = 6.5
gravity = Vector3(0, 0, 0)
scale_min = 0.08
scale_max = 0.2
color = Color(0.5, 0.85, 1.0, 1)
hue_variation_min = -0.03
hue_variation_max = 0.03

; ========== 双喷: 亮蓝细焰柱 ==========
[sub_resource type="StandardMaterial3D" id="MatDouble"]
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(0.55, 0.85, 1.0, 1)
emission_enabled = true
emission = Color(0.35, 0.75, 1.0, 1)
emission_energy_multiplier = 4.5
