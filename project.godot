[physics]

; 用户反馈弯坡抖动 (球-trimesh 接触跳变), 老公说"我不害怕物理成本×10"
; 把物理 tick 拉到 240Hz, 物理积分步长 4.17ms (约渲染帧的 1/4),
; 球-trimesh 接触每帧解算 4 次, 微小法线差异被超高频迭代彻底吃掉
; 接触迭代 32 次让 solver 完全收敛, 不留任何残余抖动
; 性能: CPU 物理 ~4x, 老公的电脑配置高完全可承受
common/physics_ticks_per_second=240
3d/solver/solver_iterations=32
; 注: 之前还改过 contact_max_allowed_penetration / default_contact_bias / contact_recycle_radius,
;     但 default_contact_bias=0 会消除碰撞反弹震动同时让接触摩擦行为变弱, 引发"地面摩擦力变小"问题.
;     已全部回滚到引擎默认, 只保留 ticks_per_second 和 solver_iterations 这两个安全的提升.

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/glow_quality=1
